{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/data/**",
              "ui_kits/brand-guide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Arabic|Noto Kufi Arabic|IBM Plex Sans|IBM Plex Mono|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Arabic, Noto Kufi Arabic, IBM Plex Sans, IBM Plex Mono, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconEnd|disabled|href|type|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconEnd, disabled, href, type, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|link|gold|ghostDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'link' | 'gold' | 'ghostDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerMotif'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|edge|corners|key|ref|className|style|children)$/]",
        "message": "<CornerMotif> doesn't accept that prop. Declared props: size, edge, corners."
      },
      {
        "selector": "JSXOpeningElement[name.name='CornerMotif'] > JSXAttribute[name.name='corners'] > Literal[value!=/^(?:both|tl|br)$/]",
        "message": "<CornerMotif> corners must be one of 'both' | 'tl' | 'br'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|numeric|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, numeric."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|end)$/]",
        "message": "<DataTableColumn> align must be one of 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|tag|tagTone|meta|title|sample|sampleFont|description|thumb|href|cta|ctaVariant|secondaryHref|secondaryLabel|key|ref|className|style|children)$/]",
        "message": "<DownloadCard> doesn't accept that prop. Declared props: kind, tag, tagTone, meta, title, sample, sampleFont, description, thumb, href, cta, ctaVariant, secondaryHref, secondaryLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:font|template)$/]",
        "message": "<DownloadCard> kind must be one of 'font' | 'template'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadCard'] > JSXAttribute[name.name='tagTone'] > Literal[value!=/^(?:petrol|orange)$/]",
        "message": "<DownloadCard> tagTone must be one of 'petrol' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadCard'] > JSXAttribute[name.name='sampleFont'] > Literal[value!=/^(?:display|body|mono)$/]",
        "message": "<DownloadCard> sampleFont must be one of 'display' | 'body' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadCard'] > JSXAttribute[name.name='ctaVariant'] > Literal[value!=/^(?:primary|secondary|outline)$/]",
        "message": "<DownloadCard> ctaVariant must be one of 'primary' | 'secondary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|flip|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, flip, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|size|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: icon, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:solid|petrol|gold|orange|ring)$/]",
        "message": "<IconTile> tone must be one of 'solid' | 'petrol' | 'gold' | 'orange' | 'ring'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|treatment|title|ratio|placeholder|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: src, alt, treatment, title, ratio, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:corner|scrim|frame)$/]",
        "message": "<ImageFrame> treatment must be one of 'corner' | 'scrim' | 'frame'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|icon|iconTone|delta|deltaStatus|note|dark|progress|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: label, value, icon, iconTone, delta, deltaStatus, note, dark, progress."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='iconTone'] > Literal[value!=/^(?:petrol|gold|orange)$/]",
        "message": "<KpiCard> iconTone must be one of 'petrol' | 'gold' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='deltaStatus'] > Literal[value!=/^(?:done|progress|late|new)$/]",
        "message": "<KpiCard> deltaStatus must be one of 'done' | 'progress' | 'late' | 'new'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|assetBase|alt|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, assetBase, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:color|petrol|white)$/]",
        "message": "<Logo> variant must be one of 'color' | 'petrol' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|active|onClick|key|ref|className|style|children)$/]",
        "message": "<NavPill> doesn't accept that prop. Declared props: children, href, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|width|showLabel|onDark|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, width, showLabel, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:petrol|orange|gold)$/]",
        "message": "<ProgressBar> tone must be one of 'petrol' | 'orange' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|label|children|onDark|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: number, title, label, children, onDark."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|compact|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, children, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:done|progress|late|new)$/]",
        "message": "<StatusPill> status must be one of 'done' | 'progress' | 'late' | 'new'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
